# Copy to .env.local. Never put secrets in NEXT_PUBLIC_ variables.
ADMIN_PASSWORD=
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required for persistent Vercel deployment; optional for local file storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public origin of your production server, without a trailing slash.
APP_ORIGIN=http://localhost:3000
# Optional GitHub Pages frontend allowed to access this server.
FRONTEND_ORIGIN=https://qthlpy-collab.github.io
NEXT_PUBLIC_API_URL=
